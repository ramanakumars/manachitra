{
    "name": "manachitra",
    "version": "0.0.1",
    "description": "Web mapping framework for planetary bodies",
    "license": "GPL-3.0-only",
    "author": "Ramanakumar Sankar",
    "type": "module",
    "main": "src/index.ts",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "test": "vitest run",
        "test:watch": "vitest",
        "coverage": "vitest run --coverage",
        "lint": "eslint .",
        "typecheck": "tsc",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check": "npm run lint && npm run typecheck && npm run format:check && npm test"
    },
    "dependencies": {
        "geotiff": "^3.1.0-beta.0",
        "geotiff-geokeys-to-proj4": "^2026.10.9",
        "ol": "^10.11.0",
        "proj4": "^2.23.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@vitest/coverage-v8": "^5.1.0",
        "eslint": "^10.15.0",
        "globals": "^17.14.0",
        "jiti": "^2.7.0",
        "jsdom": "^31.0.1",
        "prettier": "^3.8.3",
        "typescript": "~6.0",
        "typescript-eslint": "^8.73.0",
        "vite": "^8.3.8",
        "vitest": "^5.1.0"
    },
    "types": "src/index.ts"
}
